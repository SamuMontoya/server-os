[Unit]
Description=server-os · dashboard (Next.js)
After=network-online.target hermes-agent.service
Wants=network-online.target
# Ojo: StartLimit* va en [Unit], no en [Service] — systemd los movió y en
# [Service] quedan ignorados. Si se reinicia 5 veces en 5 min algo está
# roto de verdad: mejor parar y que quede en el journal que un bucle
# que llena el disco de logs.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=__ROOT__

Environment=HOME=__HOME__
Environment=NODE_ENV=production
Environment=PATH=__PATH__

# Sin build, `next start` tarda 9s en morir y no dice qué le falta: el journal
# se llena de cinco arranques de Next y acaba en "Start request repeated too
# quickly", que parece un problema del servicio y no lo es. Esto falla en el
# acto y deja en el log la única frase que importa.
ExecStartPre=/bin/sh -c '[ -f __ROOT__/apps/web/.next/BUILD_ID ] || { echo "FALTA el build de produccion en apps/web/.next — el dashboard no puede arrancar. Compila con: ./scripts/deploy-linux.sh --detach"; exit 1; }'

# `start` solo sirve el build ya compilado. Compilar es otra historia: lo hace
# scripts/deploy-linux.sh, a un directorio aparte que solo reemplaza a este
# cuando el build terminó bien.
ExecStart=__PNPM__ --filter @hermes/web start

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=server-os-web

MemoryMax=900M
MemoryHigh=700M

[Install]
WantedBy=default.target
